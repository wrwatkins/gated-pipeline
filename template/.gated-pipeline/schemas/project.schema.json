{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "protectedBranches": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "lint": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "typecheck": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "build": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "e2e": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sast": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "audit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "structure": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "test",
        "lint",
        "typecheck",
        "build",
        "e2e",
        "sast",
        "audit",
        "structure"
      ]
    },
    "requiredChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredChecks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "requiredChecks"
      ]
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "e2e": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "infrastructure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "api",
        "e2e",
        "infrastructure"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "type": "boolean"
        },
        "performance": {
          "type": "boolean"
        },
        "accessibility": {
          "type": "boolean"
        },
        "seo": {
          "type": "boolean"
        }
      },
      "required": [
        "dependencies",
        "performance",
        "accessibility",
        "seo"
      ]
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "technology": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "taskLedger": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "architecture",
        "technology",
        "taskLedger"
      ]
    },
    "independentReview": {
      "type": "boolean"
    },
    "cadenceBaseline": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schemaVersion",
    "protectedBranches",
    "commands",
    "requiredChecks",
    "ci",
    "paths",
    "capabilities",
    "documents",
    "independentReview",
    "cadenceBaseline"
  ]
}
