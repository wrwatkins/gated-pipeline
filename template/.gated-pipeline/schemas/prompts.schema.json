{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "evaluationRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version",
          "path",
          "sha256",
          "owner",
          "evaluationRef"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "prompts"
  ],
  "additionalProperties": false
}
